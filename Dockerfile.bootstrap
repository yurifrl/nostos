# syntax=docker/dockerfile:1

# Multi-stage build for the nostos-bootstrap controller (cmd/bootstrap).
# Produces a statically-linked, CGO-disabled binary on a distroless static
# base, suitable for multi-arch (linux/amd64 + linux/arm64).

# ---- builder ----
FROM --platform=$BUILDPLATFORM golang:1.25 AS builder

# TARGETOS/TARGETARCH are provided by buildx for cross-compilation.
ARG TARGETOS
ARG TARGETARCH

WORKDIR /src

# Cache module downloads.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Build the controller.
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/bootstrap ./cmd/bootstrap

# ---- runtime ----
FROM gcr.io/distroless/static:nonroot

COPY --from=builder /out/bootstrap /bootstrap

USER nonroot:nonroot
ENTRYPOINT ["/bootstrap"]
